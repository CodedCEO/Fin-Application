{
  "info": {
    "_postman_id": "5f0c1a2e-8a4b-4d7e-9c1f-3b2a6d8e4f10",
    "name": "Fin-Application",
    "description": "Accounts and Cards API for the Fin-Application Spring Boot service.\n\nSuggested flow (each step saves what the next one needs into collection variables):\n1. Accounts > Create Account  -> saves {{accountNumber}}\n2. Cards > Create Card        -> saves {{defaultPin}} and {{cvv}}\n3. Cards > Activate Card\n4. Cards > Get Single Card / Get All Cards\n\nChange {{baseUrl}} in the collection variables if the app is not running on localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "    pm.collectionVariables.set(\"accountNumber\", String(res.data));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Ada Obi\",\n    \"email\": \"ada.obi@example.com\",\n    \"mobileNumber\": \"{{mobileNumber}}\",\n    \"accountsDto\": {\n        \"accountType\": \"Savings\",\n        \"branchAddress\": \"Abuja\",\n        \"amount\": 50000\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "create"]
            },
            "description": "Creates a customer and an account. `amount` is the opening balance; it must cover the card fee (VISA 1500, MASTERCARD 1200, VERVE 1000) before you can create a card. The generated account number is saved to {{accountNumber}}."
          }
        },
        {
          "name": "Fetch Account",
          "protocolProfileBehavior": { "followRedirects": false },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/api/fetch?mobileNumber={{mobileNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "api", "fetch"],
              "query": [
                { "key": "mobileNumber", "value": "{{mobileNumber}}" }
              ]
            },
            "description": "Fetches the customer and account linked to a mobile number. Returns 302 FOUND on success."
          }
        },
        {
          "name": "Update Account",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Ada Obi\",\n    \"email\": \"ada.obi@example.com\",\n    \"mobileNumber\": \"{{mobileNumber}}\",\n    \"accountsDto\": {\n        \"accountNumber\": {{accountNumber}},\n        \"accountType\": \"Current\",\n        \"branchAddress\": \"Lagos\"\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/api/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "api", "update"]
            },
            "description": "Updates account type/branch and customer details. The account is looked up by `accountsDto.accountNumber`."
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/api/delete?mobileNumber={{mobileNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "api", "delete"],
              "query": [
                { "key": "mobileNumber", "value": "{{mobileNumber}}" }
              ]
            },
            "description": "Deletes the customer and account linked to a mobile number."
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Create Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const data = pm.response.json().data;",
                  "if (data) {",
                  "    pm.collectionVariables.set(\"defaultPin\", data.defaultPin);",
                  "    pm.collectionVariables.set(\"cvv\", data.cvv);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accountNumber\": \"{{accountNumber}}\",\n    \"cardType\": \"VISA\",\n    \"requestMode\": \"ONLINE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cards/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cards", "create"]
            },
            "description": "Issues a card for an active account.\n\n- `cardType`: VISA | MASTERCARD | VERVE\n- `requestMode`: ONLINE | PHYSICAL (PHYSICAL also requires `bankBranch`)\n\nThe response is the only time the full PAN, CVV and default PIN are returned; the default PIN and CVV are saved to collection variables for Activate Card."
          }
        },
        {
          "name": "Activate Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accountNumber\": \"{{accountNumber}}\",\n    \"defaultPin\": \"{{defaultPin}}\",\n    \"newPin\": \"{{newPin}}\",\n    \"cvv\": \"{{cvv}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cards/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cards", "activate"]
            },
            "description": "Activates a card using the default PIN and CVV from Create Card, and sets a new 4-digit PIN."
          }
        },
        {
          "name": "Get Single Card",
          "protocolProfileBehavior": { "followRedirects": false },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cards/{{accountNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cards", "{{accountNumber}}"]
            },
            "description": "Fetches the card linked to an account number. Returns 302 FOUND on success."
          }
        },
        {
          "name": "Get All Cards (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Response has page metadata\", () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.keys(\"content\", \"page\", \"size\", \"totalElements\", \"totalPages\", \"first\", \"last\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cards?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cards"],
              "query": [
                { "key": "page", "value": "0", "description": "Zero-based page index. Default 0." },
                { "key": "size", "value": "10", "description": "Cards per page, 1-100. Default 10." }
              ]
            },
            "description": "Returns one page of cards plus paging metadata (`page`, `size`, `totalElements`, `totalPages`, `first`, `last`). All query parameters are optional. A page past the end returns an empty `content` list; invalid parameters return 400."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Hello",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hello",
              "host": ["{{baseUrl}}"],
              "path": ["hello"]
            },
            "description": "Quick check that the app is running."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "mobileNumber", "value": "08012345678" },
    { "key": "accountNumber", "value": "" },
    { "key": "defaultPin", "value": "" },
    { "key": "cvv", "value": "" },
    { "key": "newPin", "value": "4321" }
  ]
}
